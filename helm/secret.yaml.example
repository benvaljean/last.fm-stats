apiVersion: v1
kind: Secret
metadata:
  name: musicstats-db-credentials
type: Opaque
stringData:
  # Bitnami MySQL requires these exact keys when auth.existingSecret is used.
  mysql-root-password: blahblah1234root
  mysql-password: blahblah1234  # password for auth.user
  # Kept as a clear application-facing key for external consumers.
  MUSICSTATS_DB_PASSWORD: blahblah1234
